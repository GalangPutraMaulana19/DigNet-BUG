# Nginx Configuration Example for DigNet
# Copy this content to your server block in nginx.conf
# or create a new file in /etc/nginx/sites-available/

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;
    
    # Document root - adjust path as needed
    root /var/www/html/dignet;
    index index.php index.html;
    
    # Logging
    access_log /var/log/nginx/dignet_access.log;
    error_log /var/log/nginx/dignet_error.log;
    
    # Main location block
    location / {
        # Try to serve file directly, then directory, then fall back to index.php
        try_files $uri $uri/ /index.php?$query_string;
    }
    
    # Handle clean URLs - rewrite to index.php with module parameter
    location ~ ^/([a-zA-Z0-9_-]+)/?$ {
        try_files $uri $uri/ /index.php?module=$1&$query_string;
    }
    
    # Handle /module/action URLs
    location ~ ^/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ {
        try_files $uri $uri/ /index.php?module=$1&act=$2&$query_string;
    }
    
    # Handle /module/action/id URLs
    location ~ ^/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([0-9]+)/?$ {
        try_files $uri $uri/ /index.php?module=$1&act=$2&id=$3&$query_string;
    }
    
    # Handle riwayat-detail special route
    location ~ ^/riwayat-detail/([0-9]+)/?$ {
        try_files $uri $uri/ /index.php?module=riwayat-detail&id=$1&$query_string;
    }
    
    # PHP-FPM configuration
    # Adjust the socket path based on your system:
    # - Ubuntu/Debian: unix:/var/run/php/php8.1-fpm.sock
    # - CentOS/RHEL: unix:/var/run/php-fpm/php8.1.sock
    # - TCP connection: 127.0.0.1:9000
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;  # Adjust path for your system
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_index index.php;
    }
    
    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }
    
    # Cache static assets
    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

# HTTPS Configuration (recommended)
# Uncomment and configure after setting up SSL certificate
#
# server {
#     listen 443 ssl http2;
#     server_name yourdomain.com www.yourdomain.com;
#     
#     ssl_certificate /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
#     
#     # ... rest of configuration same as above ...
# }
