# Enable URL Rewriting
RewriteEngine On

# Set the base path (adjust if installed in subdirectory)
# RewriteBase /dignet/

# Don't rewrite if the request is for an existing file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route: /riwayat-detail/123 -> index.php?module=riwayat-detail&id=123
RewriteRule ^riwayat-detail/([0-9]+)/?$ index.php?module=riwayat-detail&id=$1 [NC,L,QSA]

# Route: /admin/tambahadmin/123 -> index.php?module=admin&act=tambahadmin&id=123
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ index.php?module=admin&act=$1&id=$2 [NC,L,QSA]

# Route: /module/action/123 -> index.php?module=module&act=action&id=123
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([0-9]+)/?$ index.php?module=$1&act=$2&id=$3 [NC,L,QSA]

# Route: /admin/tambahadmin -> index.php?module=admin&act=tambahadmin
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ index.php?module=$1&act=$2 [NC,L,QSA]

# Route: /diagnosa -> index.php?module=diagnosa
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?module=$1 [NC,L,QSA]